# Extract both weight archives under this directory. It must contain base/ and ours/.
GUI_ACTOR_MODELS_ROOT=/absolute/path/to/gui-actor-models

# Choose one image tag for the installed GPU:
# gui-actor-grounder:0.1.0-rtx3090-cu126
# gui-actor-grounder:0.1.0-rtx4090-cu126
# gui-actor-grounder:0.1.0-pro6000-blackwell-cu130
GROUNDING_IMAGE=gui-actor-grounder:0.1.0-rtx4090-cu126

# Only one checkpoint is resident. Change to base and recreate the service to switch.
GUI_ACTOR_MODEL_PROFILE=ours

GROUNDING_PORT=8010
GUI_ACTOR_DEVICE=cuda:0
GUI_ACTOR_DTYPE=auto
GUI_ACTOR_ATTENTION_IMPLEMENTATION=auto
GUI_ACTOR_LOG_LEVEL=INFO
